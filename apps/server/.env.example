# Copy to `.env` for local development (Bun loads it). In production, set these on the container.

# Who can sign in, comma-separated. Outside production (NODE_ENV), the emailed sign-in code is always 123456.
ADMIN_EMAILS=organisateur@example.com

# Public address of the app, for the mail open-tracking pixel. Required in production
# (https://secret-santa.seadrive.cloud); defaults to Vite in dev.
APP_URL=

# 1/true/yes/on: every participant mail goes to the admins instead (to test the whole flow for real).
MAIL_TEST_MODE=

# 1/true/yes/on behind the reverse proxy (the Docker image sets 1): the client address is read from X-Forwarded-For.
# Then publish the container port on 127.0.0.1 only, otherwise anyone can spoof X-Forwarded-For.
TRUST_PROXY=

# Required in production (e.g. smtp.example.com). In development without SMTP_HOST, mails are printed in the server
# log instead.
SMTP_HOST=
# 465: TLS; 587 (default): STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Secret Santa <secret-santa@example.com>"
