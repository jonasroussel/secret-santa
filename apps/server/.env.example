# Copy to `.env` for local development (Bun loads it). In production, set these on the container.

# Who can sign in, comma-separated. Outside production (NODE_ENV), the emailed sign-in code is always 123456.
ADMIN_EMAILS=organisateur@example.com

# Public address of the app, for the mail open-tracking pixel. Required in production; defaults to Vite in dev.
APP_URL=https://secret-santa.seadrive.cloud

# Required in production. In development without SMTP_HOST, mails are printed in the server log instead.
SMTP_HOST=smtp.example.com
# 465: TLS; 587 (default): STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Secret Santa <secret-santa@example.com>"
